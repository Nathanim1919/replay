[3.72,"o","package format\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n)\r\n\r\n\u001b[90m// Event types for .replay format\u001b[0m\r\nconst (\r\n\tEventOutput     = \u001b[32m\"o\"\u001b[0m\r\n\tEventInput      = \u001b[32m\"i\"\u001b[0m\r\n\tEventResize     = \u001b[32m\"r\"\u001b[0m\r\n\tEventCheckpoint = \u001b[32m\"c\"\u001b[0m\r\n\tEventMarker     = \u001b[32m\"m\"\u001b[0m\r\n)\r\n\r\ntype \u001b[33mEvent\u001b[0m struct {\r\n\tTime    float64        \u001b[90m// seconds with sub-ms precision\u001b[0m\r\n\tType    string\r\n\tRawData []byte         \u001b[90m// raw terminal output bytes\u001b[0m\r\n\tSize    *TerminalSize  \u001b[90m// resize events\u001b[0m\r\n\tState   *TerminalState \u001b[90m// checkpoint events\u001b[0m\r\n\tMarker  *MarkerData    \u001b[90m// marker events\u001b[0m\r\n}\r\n"]
